{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider lerna run build",
    "size": "yarn build && size-limit",
    "check:all": "yarn check:flow && yarn check:ts && yarn size-limit && yarn check:lint",
    "check:flow": "flow check --max-warnings=0",
    "check:ts": "tsc",
    "check:lint": "eslint scripts/ packages/ docs/ --ext js,flow,md",
    "format": "prettier \"*.{js,md,json,ts}\" \"{docs,packages,scripts}/**/*.{js,md,json,ts}\" --write",
    "format:ci": "yarn format --list-different",
    "test": "yarn test:unit && yarn test:browser",
    "test:unit": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.mjs",
    "test:browser:vitest": "yarn test:browser",
    "test:bench": "vitest bench --run --config vitest.bench.config.mjs",
    "test:release": "node --test scripts/release.test.js",
    "prepare": "simple-git-hooks",
    "release:prepare": "node scripts/release.js prepare",
    "release:validate": "node scripts/release.js validate"
  },
  "nano-staged": {
    "**/*.{js,md,json,ts,flow}": "prettier --write",
    "**/*.{js,flow,md}": [
      "eslint"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "yarn nano-staged"
  },
  "engines": {
    "node": ">=24",
    "yarn": ">=1.13"
  },
  "devDependencies": {
    "@babel/core": "^7.2.2",
    "@babel/plugin-proposal-class-properties": "^7.3.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.3.2",
    "@babel/plugin-transform-runtime": "^7.2.0",
    "@babel/preset-env": "^7.3.1",
    "@babel/preset-react": "^7.0.0",
    "@lerna/prompt": "^3.6.0",
    "@rollup/plugin-babel": "^5.2.1",
    "@rollup/plugin-commonjs": "^16.0.0",
    "@rollup/plugin-node-resolve": "^10.0.0",
    "@rollup/plugin-replace": "^2.3.4",
    "@size-limit/preset-small-lib": "14.3.0",
    "@types/node": "^14.0.9",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "axios": "^0.18.0",
    "babel-plugin-dev-expression": "^0.2.1",
    "camelcase": "^5.0.0",
    "chalk": "^2.4.1",
    "codecov": "^3.6.5",
    "common-tags": "^1.4.0",
    "core-js": "^3.9.1",
    "cross-env": "^3.1.3",
    "css.escape": "^1.5.1",
    "detect-browser": "^1.5.0",
    "es5-shim": "^4.5.9",
    "eslint": "^5.7.0",
    "eslint-config-jss": "^5.0.1",
    "eslint-config-prettier": "^2.9.0",
    "flow-bin": "^0.150.1",
    "lerna": "^3.8.0",
    "nano-staged": "^1.0.2",
    "npmlog": "^4.1.2",
    "playwright": "^1.65.0",
    "prettier": "^2.4.1",
    "raf": "^3.4.0",
    "react": "^16.8.6",
    "react-test-renderer": "^16.8.6",
    "rimraf": "^2.5.4",
    "rollup": "^2.33.1",
    "rollup-plugin-terser": "^7.0.2",
    "shelljs": "^0.8.2",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "14.3.0",
    "typescript": "^4.4.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "zen-observable": "^0.6.0"
  }
}
